# ===========================================================================
# CSC310 .gitignore
# ===========================================================================

# ---------------------------------------------------------------------------
# C / C++ / gcc
# ---------------------------------------------------------------------------
# Prerequisites
*.d

# Compiled object files
*.slo
*.lo
*.o
*.obj
*.class

# Precompiled headers
*.gch
*.pch

# Preprocessed / assembly intermediates
*.i
*.ii
*.s

# Linker files
*.ilk

# Compiled dynamic libraries
*.so
*.dylib
*.dll

# Compiled static libraries
*.lai
*.la
*.a
*.lib

# Fortran module files
*.mod
*.smod

# Executables
*.exe
*.out
*.app

# gcov / coverage
*.gcno
*.gcda
*.gcov

# ---------------------------------------------------------------------------
# gdb / debugging
# ---------------------------------------------------------------------------
*.pdb
*.dwo
.gdb_history
core
core.*
vgcore.*

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
.eggs/
build/
dist/
*.manifest
*.spec
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/
ENV/

# ---------------------------------------------------------------------------
# Prolog (SWI-Prolog / SICStus)
# ---------------------------------------------------------------------------
# SWI-Prolog compiled / quick-load files
*.qlf
.swipl_history
.pl_history

# SICStus compiled / saved states
*.po
*.ql
*.sav

# ---------------------------------------------------------------------------
# Racket / DrRacket
# ---------------------------------------------------------------------------
compiled/
*.zo
*.dep
*.rkt~
# DrRacket autosave / lock files
\#*\#
.\#*

# ---------------------------------------------------------------------------
# Scheme
# ---------------------------------------------------------------------------
*.scm~
# Chez Scheme boot/object files
*.chezscheme.boot
# Guile compiled objects

# ---------------------------------------------------------------------------
# vim
# ---------------------------------------------------------------------------
# Swap files
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]
*.swp
*.swo
*.swn
# Session / persistent state
Session.vim
Sessionx.vim
.netrwhist
# Backups
*~
*.bak

# ---------------------------------------------------------------------------
# VS Code
# ---------------------------------------------------------------------------
.vscode/
*.code-workspace
.history/

# ---------------------------------------------------------------------------
# OS cruft
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Miscellaneous
# ---------------------------------------------------------------------------
.claude
modules/randomizedalgorithms/miller_rabin
modules/randomizedalgorithms/fermattest
modules/greedyalgorithms/offline_caching
modules/graphs/graph
modules/hashtables/hash_table
modules/geometry/geometric_primitives
modules/trees/b_tree
